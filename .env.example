# ==============================================================================
# AI Study Companion - Environment Variables Example
# Duplicate this file to .env.local and fill in your real credentials.
# NEVER commit .env.local or any real credentials to version control.
# ==============================================================================

# Database - MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Upstash Redis (Rate Limiting & Caching)
UPSTASH_REDIS_REST_URL=https://<your-upstash-redis-url>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Authentication - Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# NextAuth / Auth.js Configuration
AUTH_SECRET=generate-a-32-character-random-secret-e.g-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# Supabase Storage (Private PDF Storage)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Sentry Error Tracking & Observability (Optional in local dev)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Inngest Background Workflows (Optional in local dev with dev server)
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000